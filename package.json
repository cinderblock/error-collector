{
  "name": "error-collector-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/bun": "^1.4.2",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.61.0"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bun run --cwd worker dev",
    "migrate:local": "bun run --cwd worker migrate:local"
  }
}
