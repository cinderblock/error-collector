{
  "name": "@cinderblock/error-collector-core",
  "version": "0.0.0",
  "description": "Shared key derivation, grouping and event normalization for error-collector.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run ../../scripts/guard-publish.ts && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/error-collector.git",
    "directory": "packages/core"
  }
}
