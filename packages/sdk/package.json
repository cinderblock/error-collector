{
  "name": "@tomsawyerlabs/error-collector",
  "version": "0.0.0",
  "description": "Report errors, messages and user feedback (with screenshots) to an error-collector backend.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run ../../scripts/guard-publish.ts && bun run build"
  },
  "dependencies": {
    "@tomsawyerlabs/error-collector-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/error-collector.git",
    "directory": "packages/sdk"
  }
}
